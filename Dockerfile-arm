FROM --platform=linux/arm64 node:20-alpine AS production

WORKDIR /app

RUN apk add --no-cache ffmpeg python3 py3-pip \
    && pip3 install --no-cache-dir --break-system-packages you-get

# Install production dependencies first for better layer cache reuse.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy only runtime files required by the server.
COPY src ./src
COPY bin ./bin
COPY public ./public
COPY README.md ./README.md
COPY function.md ./function.md

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "src/index.js"]