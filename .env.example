# 环境变量配置示例文件
# 复制此文件为 .env.local 并填入真实值

# 抖音Cookie配置（普通公开视频走移动端 Feed 主通道可免 Cookie；PC Web 备用通道需要）
# 推荐精简格式（同时包含 sid_guard 和 UIFID，适合 Vercel 环境变量）：
DOUYIN_COOKIE=sid_guard=你的sid_guard值; UIFID=你的UIFID值;

# 也可单独配置 UIFID（可选，会覆盖 Cookie 中的 UIFID）
# DOUYIN_UIFID=你的UIFID值

# 是否启用移动端 Feed 免风控主通道（默认 1 启用，设为 0 可强制仅用 PC Web 接口）
# DOUYIN_ENABLE_MOBILE_FEED=1

# Vercel自动同步功能配置（可选）
# 如果需要Cookie更新时自动同步到Vercel环境变量，请配置以下项：

# VERCEL_TOKEN=your_vercel_token_here
# VERCEL_PROJECT_ID=your_project_id_here
# VERCEL_TEAM_ID=your_team_id_here  # 仅团队项目需要

# 获取方法：
# 1. VERCEL_TOKEN: Vercel Dashboard > Settings > Tokens
# 2. VERCEL_PROJECT_ID: 项目 Settings > General > Project ID  
# 3. VERCEL_TEAM_ID: 团队 Settings > General > Team ID (可选)
